---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import natalia from '../assets/natalia-alcaraz.jpg';

const services = [
  {
    title: 'Embarazo y posparto',
    description: 'Miedos, cambios de identidad, lactancia y emociones que pueden aparecer antes y después del nacimiento.',
    icon: 'heart',
  },
  {
    title: 'Crianza y familia',
    description: 'Pautas, límites y conflictos para acompañar la crianza con más calma y confianza.',
    icon: 'family',
  },
  {
    title: 'Duelo perinatal',
    description: 'Un espacio para transitar la pérdida gestacional y perinatal a tu propio ritmo.',
    icon: 'leaf',
  },
  {
    title: 'Ansiedad y estrés',
    description: 'Apoyo para comprender la autoexigencia, regular las emociones y afrontar momentos difíciles.',
    icon: 'mind',
  },
];

const firstSteps = [
  { number: '01', title: 'Me escribes', description: 'Cuéntame qué te preocupa. No necesitas tenerlo todo claro para dar el primer paso.' },
  { number: '02', title: 'Nos conocemos', description: 'En la primera sesión, de unos 50 minutos, hablamos de lo que necesitas y resolvemos tus dudas.' },
  { number: '03', title: 'Decidimos juntos', description: 'Valoramos si te sientes cómoda y cómo podría ayudarte. Continuar es decisión tuya.' },
];
---

<Layout title="Psicóloga perinatal online | Natalia Alcaraz">
  <section class="relative overflow-hidden bg-gradient-to-br from-primary-50 via-white to-accent-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-14 sm:py-20 lg:py-24">
      <div class="grid lg:grid-cols-[1.05fr_0.95fr] gap-10 lg:gap-16 items-center">
        <div class="space-y-6 lg:space-y-7">
          <p class="text-xs sm:text-sm font-semibold uppercase tracking-[0.16em] text-primary-700">
            Psicología perinatal · sesiones online
          </p>
          <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-semibold text-ink leading-[1.12] tracking-tight">
            No tienes que poder con todo.
            <span class="block mt-2 text-primary-700">Estoy aquí para acompañarte.</span>
          </h1>
          <p class="text-lg text-ink-light leading-relaxed max-w-xl">
            Soy Natalia, psicóloga perinatal. Te acompaño en el embarazo, el posparto y la crianza,
            con escucha, sin juicios y respetando tu ritmo.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 pt-1">
            <a href="/contacto" class="inline-flex items-center justify-center bg-primary-700 text-white px-6 py-3.5 rounded-[var(--radius-button)] text-base font-semibold hover:bg-primary-800 transition-colors shadow-sm">
              Hablemos de lo que necesitas
            </a>
            <a href="/servicios" class="inline-flex items-center justify-center bg-white/80 text-primary-800 px-6 py-3.5 rounded-[var(--radius-button)] text-base font-semibold border border-primary-200 hover:bg-white transition-colors">
              Explorar servicios
            </a>
          </div>
          <p class="text-sm text-ink-light">Primera sesión de 50 min · 55 € · 100% online</p>
        </div>
        <div class="relative max-w-lg mx-auto lg:ml-auto">
          <div class="absolute -inset-3 sm:-inset-4 rounded-[2rem] bg-primary-100/70 rotate-2" aria-hidden="true"></div>
          <Image
            src={natalia}
            alt="Natalia Alcaraz, psicóloga perinatal"
            widths={[400, 640, 818]}
            sizes="(min-width: 1024px) 42vw, 90vw"
            format="webp"
            class="relative aspect-[4/5] w-full rounded-[1.5rem] object-cover shadow-[var(--shadow-card)]"
            loading="eager"
            fetchpriority="high"
          />
          <div class="absolute -bottom-5 left-4 sm:left-8 rounded-xl bg-white px-4 py-3 shadow-[var(--shadow-card)]">
            <p class="text-sm font-semibold text-ink">Natalia Alcaraz</p>
            <p class="text-xs text-ink-light">Psicóloga colegiada M-41528</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-white border-y border-accent-100" aria-label="Información de consulta">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-5 sm:py-6 grid sm:grid-cols-3 gap-4 sm:gap-6 text-center">
      <p class="text-sm font-medium text-ink"><span class="text-primary-700">Acompañamiento profesional</span><span class="block mt-1 text-ink-light">Psicóloga General Sanitaria</span></p>
      <p class="text-sm font-medium text-ink"><span class="text-primary-700">A tu ritmo</span><span class="block mt-1 text-ink-light">Un espacio cercano y sin juicios</span></p>
      <p class="text-sm font-medium text-ink"><span class="text-primary-700">Desde donde estés</span><span class="block mt-1 text-ink-light">Sesiones por videollamada</span></p>
    </div>
  </section>

  <section class="py-16 lg:py-24 bg-surface">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mx-auto text-center mb-10 lg:mb-14">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-primary-700 mb-3">Un espacio para ti</p>
        <h2 class="text-3xl lg:text-4xl font-semibold text-ink mb-4">¿Qué te gustaría cuidar hoy?</h2>
        <p class="text-lg text-ink-light">Cada historia es distinta. Podemos empezar por aquello que ahora mismo pesa más.</p>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4 lg:gap-5">
        {services.map((service) => (
          <a href="/servicios" class="group min-h-full p-6 rounded-2xl bg-white border border-accent-100 hover:border-primary-200 hover:shadow-[var(--shadow-card-hover)] transition-all duration-300">
            <div class="w-11 h-11 rounded-full bg-primary-50 flex items-center justify-center mb-5 text-primary-700" aria-hidden="true">
              {service.icon === 'heart' && <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" /></svg>}
              {service.icon === 'family' && <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 0 0 3.75.772 9.75 9.75 0 0 0 3.75-.772M15 19.128v-.003c0-1.933-1.57-3.5-3.5-3.5S8 17.192 8 19.125v.003m7 0a12.4 12.4 0 0 1-3.5.5c-1.24 0-2.42-.18-3.5-.5m7 0a5.5 5.5 0 0 0-11 0m8-11.253a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0Z" /></svg>}
              {service.icon === 'leaf' && <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M11 20a10 10 0 0 0 10-10 25.9 25.9 0 0 0-1.04-7.281 1 1 0 0 0-1.755-.325C15.833 5.5 13 5.5 9.8 6.1A7 7 0 0 0 11 20ZM2 21a5 5 0 0 1 2.911-4.544C7.613 15.212 8.351 15.24 11 13" /></svg>}
              {service.icon === 'mind' && <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18V5m0 13a4 4 0 0 1-4 4m4-4a4 4 0 0 0 4 4M8 8a4 4 0 0 1 8 0m-8 0a4 4 0 0 0 0 8m8-8a4 4 0 0 1 0 8" /></svg>}
            </div>
            <h3 class="text-lg font-semibold text-ink mb-2">{service.title}</h3>
            <p class="text-ink-light text-sm leading-relaxed">{service.description}</p>
            <span class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-primary-700 group-hover:text-primary-800">Ver cómo puedo ayudarte <span aria-hidden="true">→</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div class="max-w-xl">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-primary-700 mb-3">Un acompañamiento a tu medida</p>
        <h2 class="text-3xl lg:text-4xl font-semibold text-ink mb-5">Hola, soy Natalia</h2>
        <div class="space-y-4 text-ink-light leading-relaxed">
          <p>Soy psicóloga perinatal y psicóloga general sanitaria, colegiada con el número <strong class="text-ink">M-41528</strong>. Acompaño a madres y padres en el embarazo, el posparto y la crianza.</p>
          <p>Mi enfoque es contextual e integrador: escucho tu historia y adapto las herramientas a lo que necesitas, cuidando que el espacio sea seguro y respetuoso con tu ritmo.</p>
        </div>
        <a href="/sobre-mi" class="mt-6 inline-flex items-center gap-2 font-semibold text-primary-700 hover:text-primary-800">Conoce más sobre mí <span aria-hidden="true">→</span></a>
      </div>
      <div class="rounded-3xl bg-primary-50 p-7 sm:p-9 lg:p-10">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-primary-700 mb-3">Dar el primer paso</p>
        <h2 class="text-2xl lg:text-3xl font-semibold text-ink mb-7">¿Cómo empezamos?</h2>
        <ol class="space-y-6">
          {firstSteps.map((step) => (
            <li class="flex gap-4">
              <span class="text-sm font-semibold text-primary-700 pt-1">{step.number}</span>
              <div><h3 class="font-semibold text-ink mb-1">{step.title}</h3><p class="text-sm text-ink-light leading-relaxed">{step.description}</p></div>
            </li>
          ))}
        </ol>
        <a href="/contacto" class="mt-8 inline-flex items-center justify-center bg-primary-700 text-white px-5 py-3 rounded-[var(--radius-button)] text-sm font-semibold hover:bg-primary-800 transition-colors">Escríbeme</a>
      </div>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-surface-alt">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl lg:text-4xl font-semibold text-ink mb-4">Quizá te preguntas...</h2>
      <p class="text-lg text-ink-light mb-8">No hace falta que tengas todas las respuestas para empezar.</p>
      <div class="grid sm:grid-cols-3 gap-4 text-left">
        <a href="/preguntas-frecuentes" class="rounded-xl bg-white p-5 border border-accent-100 hover:border-primary-200 transition-colors"><h3 class="font-semibold text-ink mb-2">¿Y si no sé qué me pasa?</h3><p class="text-sm text-ink-light">Podemos empezar por ahí. No necesitas preparar nada.</p></a>
        <a href="/preguntas-frecuentes" class="rounded-xl bg-white p-5 border border-accent-100 hover:border-primary-200 transition-colors"><h3 class="font-semibold text-ink mb-2">¿Cómo son las sesiones?</h3><p class="text-sm text-ink-light">Son online, duran unos 50 minutos y cuestan 55 €.</p></a>
        <a href="/preguntas-frecuentes" class="rounded-xl bg-white p-5 border border-accent-100 hover:border-primary-200 transition-colors"><h3 class="font-semibold text-ink mb-2">¿Y si no estoy segura?</h3><p class="text-sm text-ink-light">La primera consulta es para conocernos y decidir con calma.</p></a>
      </div>
      <a href="/preguntas-frecuentes" class="mt-6 inline-flex font-semibold text-primary-700 hover:text-primary-800">Ver todas las preguntas frecuentes →</a>
    </div>
  </section>

  <section class="py-16 lg:py-20 bg-primary-800">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-primary-200 mb-3">Cuando tú quieras</p>
      <h2 class="text-3xl lg:text-4xl font-semibold text-white mb-4">Podemos empezar por lo que hoy te preocupa</h2>
      <p class="text-lg text-primary-100 mb-8 max-w-xl mx-auto">Escríbeme y vemos juntas si este espacio puede ayudarte. Sin prisa y sin compromiso.</p>
      <a href="/contacto" class="inline-flex items-center justify-center bg-white text-primary-800 px-7 py-3.5 rounded-[var(--radius-button)] text-base font-semibold hover:bg-primary-50 transition-colors shadow-sm">Hablemos</a>
    </div>
  </section>
</Layout>
