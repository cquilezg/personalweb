---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary-50 via-white to-sage-50 py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl lg:text-5xl font-bold text-ink mb-6">
        Contacto
      </h1>
      <p class="text-lg lg:text-xl text-ink-light max-w-2xl mx-auto">
        El primer paso es el más importante. Escríbeme y te responderé lo antes posible.
      </p>
    </div>
  </section>

  <!-- Formulario + Info -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16">
        <!-- Formulario -->
        <div>
          <h2 class="text-2xl font-bold text-ink mb-6">Solicitar primera consulta</h2>
          <form class="space-y-5" action="#" method="POST">
            <div>
              <label for="name" class="block text-sm font-medium text-ink mb-1.5">
                Nombre <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                class="w-full px-4 py-3 rounded-[var(--radius-button)] border border-sage-200 bg-white text-ink placeholder-ink-muted focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-colors"
                placeholder="Tu nombre"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-ink mb-1.5">
                Email <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-[var(--radius-button)] border border-sage-200 bg-white text-ink placeholder-ink-muted focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-colors"
                placeholder="tu@email.com"
              />
            </div>

            <div>
              <label for="phone" class="block text-sm font-medium text-ink mb-1.5">
                Teléfono
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                class="w-full px-4 py-3 rounded-[var(--radius-button)] border border-sage-200 bg-white text-ink placeholder-ink-muted focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-colors"
                placeholder="600 000 000"
              />
            </div>

            <div>
              <label for="who" class="block text-sm font-medium text-ink mb-1.5">
                ¿Para quién es la terapia?
              </label>
              <select
                id="who"
                name="who"
                class="w-full px-4 py-3 rounded-[var(--radius-button)] border border-sage-200 bg-white text-ink focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-colors"
              >
                <option value="">Selecciona una opción</option>
                <option value="adulto">Adulto/a</option>
                <option value="adolescente">Adolescente</option>
                <option value="nino">Niño/a</option>
                <option value="otro">Otro</option>
              </select>
            </div>

            <div>
              <label for="reason" class="block text-sm font-medium text-ink mb-1.5">
                Motivo de consulta
              </label>
              <textarea
                id="reason"
                name="reason"
                rows="4"
                class="w-full px-4 py-3 rounded-[var(--radius-button)] border border-sage-200 bg-white text-ink placeholder-ink-muted focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-transparent transition-colors resize-none"
                placeholder="Cuéntame brevemente qué te preocupa (opcional)"
              ></textarea>
            </div>

            <div class="pt-2">
              <button
                type="submit"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-primary-600 text-white px-8 py-3.5 rounded-[var(--radius-button)] text-base font-semibold hover:bg-primary-700 transition-colors shadow-sm"
              >
                Enviar mensaje
              </button>
            </div>
          </form>
        </div>

        <!-- Información lateral -->
        <div class="space-y-8">
          <div>
            <h2 class="text-2xl font-bold text-ink mb-6">Información</h2>
            <div class="space-y-6">
              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-lg bg-primary-100 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-ink">Horario</p>
                  <p class="text-ink-light">Lunes a viernes: 9:00 — 20:00</p>
                  <p class="text-ink-light">Sábados: 9:00 — 14:00</p>
                </div>
              </div>

              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-lg bg-primary-100 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1115 0z" />
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-ink">Ubicación</p>
                  <p class="text-ink-light">Alcalá de Henares, Madrid</p>
                  <p class="text-ink-light">Sesiones 100% online</p>
                </div>
              </div>

              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-lg bg-primary-100 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-ink">Email</p>
                  <a href="mailto:tu@email.com" class="text-primary-600 hover:text-primary-700 transition-colors">tu@email.com</a>
                </div>
              </div>

              <div class="flex gap-4">
                <div class="w-10 h-10 rounded-lg bg-primary-100 flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                  </svg>
                </div>
                <div>
                  <p class="font-semibold text-ink">Teléfono</p>
                  <a href="tel:+34600000000" class="text-primary-600 hover:text-primary-700 transition-colors">600 000 000</a>
                </div>
              </div>
            </div>
          </div>

          <!-- Nota de privacidad -->
          <div class="p-5 rounded-xl bg-surface border border-sage-100">
            <p class="text-sm text-ink-light leading-relaxed">
              Tus datos serán tratados con confidencialidad y únicamente serán utilizados para gestionar tu consulta.
              Puedes ejercer tus derechos de acceso, rectificación y eliminación contactando por email.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
