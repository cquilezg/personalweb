---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import natalia from '../assets/natalia-alcaraz.jpg';

const services = [
  {
    title: 'Psicología perinatal',
    description: 'Embarazo, parto y posparto: miedos, cambios de identidad, lactancia y todo lo que no siempre se cuenta.',
    icon: 'heart',
  },
  {
    title: 'Crianza y familia',
    description: 'Pautas y límites, gestión de conflictos y acompañamiento a madres y padres que quieren criar con más calma.',
    icon: 'baby',
  },
  {
    title: 'Duelo y pérdida perinatal',
    description: 'Acompañamiento en la pérdida gestacional, el duelo perinatal y otras pérdidas que necesitan su tiempo.',
    icon: 'leaf',
  },
  {
    title: 'Ansiedad y estrés',
    description: 'Ansiedad, autoexigencia y dificultades para regular las emociones.',
    icon: 'brain',
  },
];
---

<Layout title="Psicóloga perinatal en Alcalá de Henares">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-primary-50 via-white to-accent-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Texto -->
        <div class="space-y-6 lg:space-y-8">
          <p class="text-xs sm:text-sm font-semibold uppercase tracking-[0.18em] text-primary-600">
            Natalia Alcaraz · Psicóloga perinatal
          </p>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-ink leading-tight">
            Acompaño a familias
            <span class="text-primary-600">en el embarazo, el posparto y la crianza</span>
          </h1>
          <p class="text-lg lg:text-xl text-ink-light leading-relaxed max-w-xl">
            Un espacio seguro para madres y padres que atraviesan el embarazo, el posparto
            o la crianza. Trabajo contigo y con tu familia, a tu ritmo y sin juicios.
            Sesiones online.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="/contacto"
              class="inline-flex items-center justify-center gap-2 bg-primary-600 text-white px-6 py-3.5 rounded-[var(--radius-button)] text-base font-semibold hover:bg-primary-700 transition-colors shadow-sm"
            >
              Solicitar primera consulta
            </a>
            <a
              href="/servicios"
              class="inline-flex items-center justify-center gap-2 bg-white text-primary-700 px-6 py-3.5 rounded-[var(--radius-button)] text-base font-semibold border border-primary-200 hover:bg-primary-50 transition-colors"
            >
              Ver mis servicios
            </a>
          </div>
        </div>

        <!-- Foto profesional -->
        <div class="relative">
          <Image
            src={natalia}
            alt="Natalia Alcaraz, psicóloga"
            widths={[400, 640, 818]}
            sizes="(min-width: 1024px) 40vw, 90vw"
            format="webp"
            class="aspect-square w-full rounded-2xl object-cover shadow-[var(--shadow-card)]"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Áreas de acompañamiento -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 lg:mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-ink mb-4">
          En qué puedo acompañarte
        </h2>
        <p class="text-lg text-ink-light">
          Cada etapa tiene sus propios retos. Trabajo con herramientas basadas en la evidencia,
          adaptadas a ti y a tu familia.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 gap-6 lg:gap-8 max-w-4xl mx-auto">
        {services.map((service) => (
          <a
            href="/servicios"
            class="group block p-6 rounded-2xl bg-surface border border-accent-100 hover:border-primary-200 hover:shadow-[var(--shadow-card-hover)] transition-all duration-300"
          >
            <div class="w-12 h-12 rounded-xl bg-primary-100 flex items-center justify-center mb-4 group-hover:bg-primary-200 transition-colors">
              {service.icon === 'brain' && (
                <svg class="w-6 h-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 18V5" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 13a4.17 4.17 0 01-3-4 4.17 4.17 0 01-3 4" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.707 6.294A3 3 0 1012 5a3 3 0 10-5.707 1.294" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.996 5.125a4 4 0 012.526 5.77" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M18 18a4 4 0 002-7.465" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.967 17.482a4 4 0 11-7.967.517 4 4 0 11-7.967-.517" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18a4 4 0 01-2-7.465" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6.004 5.125a4 4 0 00-2.526 5.77" />
                </svg>
              )}
              {service.icon === 'heart' && (
                <svg class="w-6 h-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                </svg>
              )}
              {service.icon === 'baby' && (
                <svg class="w-6 h-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M10 16c.5.3 1.2.5 2 .5s1.5-.2 2-.5" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12h.01" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19.38 6.813A9 9 0 0 1 20.8 10.2a2 2 0 0 1 0 3.6 9 9 0 0 1-17.6 0 2 2 0 0 1 0-3.6A9 9 0 0 1 12 3c2 0 3.5 1.1 3.5 2.5s-.9 2.5-2 2.5c-.8 0-1.5-.4-1.5-1" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h.01" />
                </svg>
              )}
              {service.icon === 'leaf' && (
                <svg class="w-6 h-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11 20a10 10 0 0010-10 25.9 25.9 0 00-1.04-7.281 1 1 0 00-1.755-.325C15.833 5.5 13 5.5 9.8 6.1A7 7 0 0011 20" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2 21a5 5 0 012.911-4.544C7.613 15.212 8.351 15.24 11 13" />
                </svg>
              )}
            </div>
            <h3 class="text-lg font-semibold text-ink mb-2">{service.title}</h3>
            <p class="text-ink-light text-base leading-relaxed">{service.description}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-primary-600 group-hover:text-primary-700">
              Saber más
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-primary-700 to-primary-800">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">
        ¿Empezamos por lo que te preocupa?
      </h2>
      <p class="text-lg text-primary-100 mb-8 max-w-xl mx-auto">
        Soy Natalia. En la primera consulta escucho tu historia y vemos juntos cómo puedo ayudarte.
        Sin compromiso.
      </p>
      <a
        href="/contacto"
        class="inline-flex items-center justify-center gap-2 bg-white text-primary-700 px-8 py-4 rounded-[var(--radius-button)] text-base font-semibold hover:bg-primary-50 transition-colors shadow-sm"
      >
        Solicitar primera consulta
      </a>
    </div>
  </section>
</Layout>
