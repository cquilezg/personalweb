---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    title: 'Ansiedad y estrés',
    description: 'Aprende a gestionar la ansiedad, el estrés y las preocupaciones que te impiden disfrutar del día a día.',
    icon: 'brain',
  },
  {
    title: 'Autoestima',
    description: 'Mejora la relación contigo mismo/a, descubre tu valor y deja de compararte.',
    icon: 'heart',
  },
  {
    title: 'Dificultades emocionales',
    description: 'Trabaja tus emociones, aprende a regularlas y encuentra equilibrio interior.',
    icon: 'sparkles',
  },
  {
    title: 'Problemas de conducta en niños',
    description: 'Acompañamiento para dificultades de comportamiento, adaptación escolar y desarrollo emocional.',
    icon: 'child',
  },
  {
    title: 'Adolescencia',
    description: 'Ayuda profesional para navigar los retos de la adolescencia: identidad, presión social, autoestima.',
    icon: 'users',
  },
  {
    title: 'Duelo y pérdidas',
    description: 'Acompañamiento para processar pérdidas y encontrar caminos hacia la sanación.',
    icon: 'leaf',
  },
];
---

<Layout title="Inicio">
  <!-- Hero -->
  <section class="relative overflow-hidden bg-gradient-to-br from-primary-50 via-white to-sage-50">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Texto -->
        <div class="space-y-6 lg:space-y-8">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-ink leading-tight">
            Psicología para ayudarte a
            <span class="text-primary-600">sentirte mejor</span>
          </h1>
          <p class="text-lg lg:text-xl text-ink-light leading-relaxed max-w-xl">
            Acompañamiento psicológico profesional para niños, adolescentes y adultos.
            Sesiones online desde Alcalá de Henares.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href="/contacto"
              class="inline-flex items-center justify-center gap-2 bg-primary-600 text-white px-6 py-3.5 rounded-[var(--radius-button)] text-base font-semibold hover:bg-primary-700 transition-colors shadow-sm"
            >
              Solicitar primera consulta
            </a>
            <a
              href="/servicios"
              class="inline-flex items-center justify-center gap-2 bg-white text-primary-700 px-6 py-3.5 rounded-[var(--radius-button)] text-base font-semibold border border-primary-200 hover:bg-primary-50 transition-colors"
            >
              Ver servicios
            </a>
          </div>
        </div>

        <!-- Imagen placeholder -->
        <div class="relative">
          <div class="aspect-[4/3] rounded-2xl bg-gradient-to-br from-primary-100 to-sage-100 flex items-center justify-center shadow-[var(--shadow-card)]">
            <div class="text-center space-y-3 p-8">
              <div class="w-24 h-24 mx-auto rounded-full bg-primary-200 flex items-center justify-center">
                <svg class="w-12 h-12 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" />
                </svg>
              </div>
              <p class="text-sm text-primary-600 font-medium">Foto profesional</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Problemas que atiendo -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 lg:mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-ink mb-4">
          ¿Qué puedo ayudarte?
        </h2>
        <p class="text-lg text-ink-light">
          Cada persona es diferente. Trabajo con problemas comunes que afectan a niños, adolescentes y adultos.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {services.map((service) => (
          <div class="group p-6 rounded-2xl bg-surface border border-sage-100 hover:border-primary-200 hover:shadow-[var(--shadow-card-hover)] transition-all duration-300">
            <div class="w-12 h-12 rounded-xl bg-primary-100 flex items-center justify-center mb-4 group-hover:bg-primary-200 transition-colors">
              {service.icon === 'brain' && (
                <svg class="w-6 h-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v5.714a2.25 2.25 0 01-.659 1.591L5 14.5M9.75 3.104c-.251.023-.501.05-.75.082m.75-.082a24.301 24.301 0 014.5 0m0 0v5.714c0 .597.237 1.17.659 1.591L19.8 15.3M14.25 3.104c.251.023.501.05.75.082M19.8 15.3l-1.57.393A9.065 9.065 0 0112 15a9.065 9.065 0 00-6.23.693L5 14.5m14.8.8l1.402 1.402c1.232 1.232.65 3.318-1.067 3.611A48.309 48.309 0 0112 21c-2.773 0-5.491-.235-8.135-.687-1.718-.293-2.3-2.379-1.067-3.61L5 14.5" />
                </svg>
              )}
              {service.icon === 'heart' && (
                <svg class="w-6 h-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z" />
                </svg>
              )}
              {service.icon === 'sparkles' && (
                <svg class="w-6 h-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09zM18.259 8.715L18 9.75l-.259-1.035a3.375 3.375 0 00-2.455-2.456L14.25 6l1.036-.259a3.375 3.375 0 002.455-2.456L18 2.25l.259 1.035a3.375 3.375 0 002.455 2.456L21.75 6l-1.036.259a3.375 3.375 0 00-2.455 2.456z" />
                </svg>
              )}
              {service.icon === 'child' && (
                <svg class="w-6 h-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.182 15.182a4.5 4.5 0 01-6.364 0M21 12a9 9 0 11-18 0 9 9 0 0118 0zM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75zm-.375 0h.008v.015h-.008V9.75zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75zm-.375 0h.008v.015h-.008V9.75z" />
                </svg>
              )}
              {service.icon === 'users' && (
                <svg class="w-6 h-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
                </svg>
              )}
              {service.icon === 'leaf' && (
                <svg class="w-6 h-6 text-primary-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418" />
                </svg>
              )}
            </div>
            <h3 class="text-lg font-semibold text-ink mb-2">{service.title}</h3>
            <p class="text-ink-light text-sm leading-relaxed">{service.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA final -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-primary-600 to-primary-800">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">
        ¿Listo para dar el primer paso?
      </h2>
      <p class="text-lg text-primary-100 mb-8 max-w-xl mx-auto">
        La primera consulta es un espacio seguro para que me cuentes lo que te preocupa.
        Sin compromiso.
      </p>
      <a
        href="/contacto"
        class="inline-flex items-center justify-center gap-2 bg-white text-primary-700 px-8 py-4 rounded-[var(--radius-button)] text-base font-semibold hover:bg-primary-50 transition-colors shadow-sm"
      >
        Solicitar primera consulta
      </a>
    </div>
  </section>
</Layout>
