---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    title: 'Psicología perinatal',
    description: 'El embarazo, el parto y el posparto no siempre son como nos contaron. Miedos, cambios de identidad, lactancia, agotamiento, culpa... Te acompaño para que puedas vivir esta etapa con más calma y menos exigencias.',
    details: ['Embarazo y miedo al parto', 'Ansiedad y depresión posparto', 'Lactancia y crianza', 'Cambios de identidad', 'Duelo perinatal'],
  },
  {
    title: 'Crianza y familia',
    description: 'Criar no viene con manual. Si sientes que los límites no funcionan, que pierdes la paciencia o que cada día es una negociación, podemos revisar juntos qué está pasando.',
    details: ['Pautas y límites', 'Gestión de conflictos', 'Celos y rivalidad', 'Separación y cambios familiares', 'Crianza respetuosa'],
  },
  {
    title: 'Duelo y pérdida perinatal',
    description: 'La pérdida de un embarazo o de un bebé es un duelo que muchas veces se vive en silencio. Te acompaño a darle lugar, sin prisas y sin tener que explicar nada que no quieras.',
    details: ['Pérdida gestacional', 'Duelo perinatal', 'Pérdidas posteriores', 'Acompañamiento a la pareja'],
  },
  {
    title: 'Ansiedad y estrés',
    description: 'Cuando la cabeza no para, el cuerpo se tensa y todo se vuelve cuesta arriba. Te ayudo a entender qué te pasa y a recuperar un poco de calma.',
    details: ['Ansiedad y preocupación constante', 'Autoexigencia', 'Estrés y agotamiento', 'Regulación emocional'],
  },
];
---

<Layout title="Mis servicios">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary-50 via-white to-sage-50 py-16 lg:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-4xl lg:text-5xl font-bold text-ink mb-6">
        Mis servicios
      </h1>
      <p class="text-lg lg:text-xl text-ink-light max-w-2xl mx-auto">
        No trabajo con etiquetas, sino con personas. Estas son las áreas en las que puedo
        acompañarte; si no ves la tuya, escríbeme y lo hablamos.
      </p>
    </div>
  </section>

  <!-- Áreas de acompañamiento -->
  <section class="py-16 lg:py-24 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12 lg:space-y-16">
      {services.map((service, index) => (
        <div class:list={[
          'grid lg:grid-cols-2 gap-8 lg:gap-16 items-start',
          index % 2 === 1 && 'lg:grid-flow-dense',
        ]}>
          <div class:list={[index % 2 === 1 && 'lg:col-start-2']}>
            <div class="space-y-4">
              <h2 class="text-2xl lg:text-3xl font-bold text-ink">{service.title}</h2>
              <p class="text-ink-light leading-relaxed">{service.description}</p>
              <ul class="flex flex-wrap gap-2 pt-2">
                {service.details.map((detail) => (
                  <li class="text-sm bg-primary-50 text-primary-700 px-3 py-1.5 rounded-full">
                    {detail}
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <div class:list={[index % 2 === 1 && 'lg:col-start-1']}>
            <div class="aspect-[4/3] rounded-2xl bg-gradient-to-br from-primary-50 to-sage-50 flex items-center justify-center">
              <div class="text-center space-y-2 p-6">
                <div class="w-16 h-16 mx-auto rounded-full bg-primary-100 flex items-center justify-center">
                  <svg class="w-8 h-8 text-primary-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" />
                  </svg>
                </div>
                <p class="text-xs text-primary-400">Ilustración</p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-16 lg:py-24 bg-gradient-to-br from-primary-600 to-primary-800">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl lg:text-4xl font-bold text-white mb-4">
        ¿Te suena alguna de estas situaciones?
      </h2>
      <p class="text-lg text-primary-100 mb-8 max-w-xl mx-auto">
        No tienes que seguir solo/a. Escríbeme y cuéntame qué te pasa; vemos juntos cómo puedo ayudarte.
      </p>
      <a
        href="/contacto"
        class="inline-flex items-center justify-center gap-2 bg-white text-primary-700 px-8 py-4 rounded-[var(--radius-button)] text-base font-semibold hover:bg-primary-50 transition-colors shadow-sm"
      >
        Solicitar primera consulta
      </a>
    </div>
  </section>
</Layout>
